# Copy this file to .env.local for local development,
# and add the same variables in Vercel → Settings → Environment Variables.
# Never commit real values.

# --- Admin login ---
# The password you type on /admin/login. Use something long (16+ characters).
ADMIN_PASSWORD=change-me-to-a-long-password
# A long random string used to sign the login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=paste-a-64-character-random-string-here

# --- MongoDB (stores your content + contact messages) ---
# Without this, the site still works and shows the starter content from lib/seed.ts,
# but the admin page can't save changes.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dynatech

# --- Cloudinary (image uploads from the admin page) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Optional ---
# Your live address, used for link previews on WhatsApp/X/LinkedIn.
NEXT_PUBLIC_SITE_URL=https://dynatech-labs.vercel.app
